local warningTimer = nil
local function ShowWarning(text, color)
    if warningTimer then
        warningTimer:Disconnect()
        warningTimer = nil
    end
    warningLabel.Text = text
    warningLabel.TextColor3 = color or Color3.fromRGB(255, 200, 0)
    warningTimer = task.delay(3, function()
        warningLabel.Text = ""
        warningTimer = nil
    end)
end

