local function UpdateWhitelistUI()
    if not WhitelistListFrame then return end
    for _, child in ipairs(WhitelistListFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    local yPos = 0
    for name, _ in pairs(Whitelist) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 25)
        btn.Position = UDim2.new(0, 0, 0, yPos)
        btn.BackgroundTransparency = 0.5
        btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        btn.Text = name
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.TextSize = 14
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.Parent = WhitelistListFrame
        btn.MouseButton1Click:Connect(function() inputBox.Text = name end)
        yPos = yPos + 25
    end
    WhitelistListFrame.CanvasSize = UDim2.new(0, 0, 0, yPos + 5)
end

local function FindPlayerByPrefix(prefix)
    local found = {}
    local lowerPrefix = string.lower(prefix)
    for _, player in ipairs(Players:GetPlayers()) do
        local name = player.Name
        if string.lower(string.sub(name, 1, #prefix)) == lowerPrefix then
            table.insert(found, player)
        end
    end
    if #found == 1 then return found[1] end
    return nil
end

Players.PlayerRemoving:Connect(function(player)
    if Whitelist[player.Name] then
        Whitelist[player.Name] = nil
        UpdateWhitelistUI()
    end
    RemovePlayerESP(player)
end)

addButton.MouseButton1Click:Connect(function()
    local inputName = inputBox.Text:gsub("^%s*(.-)%s*$", "%1")
    if inputName == "" then return end
    if inputName == "/todos" then
        local added = 0
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and not Whitelist[player.Name] then
                Whitelist[player.Name] = true
                added = added + 1
            end
        end
        if added > 0 then
            UpdateWhitelistUI()
            UpdateAllESPColors()
            ShowWarning(string.format("✅ %d jogadores adicionados à Whitelist.", added), Color3.fromRGB(0, 255, 0))
        else
            ShowWarning("⚠️ Nenhum jogador novo para adicionar.", Color3.fromRGB(255, 200, 0))
        end
        inputBox.Text = ""
        return
    end
    local targetPlayer = FindPlayerByPrefix(inputName)
    if targetPlayer then
        local fullName = targetPlayer.Name
        if Whitelist[fullName] then
            ShowWarning(string.format("⚠️ '%s' já está na Whitelist!", fullName), Color3.fromRGB(255, 100, 100))
            return
        end
        Whitelist[fullName] = true
        UpdateWhitelistUI()
        UpdateAllESPColors()
        ShowWarning(string.format("✅ '%s' adicionado à Whitelist.", fullName), Color3.fromRGB(0, 255, 0))
        inputBox.Text = ""
    else
        ShowWarning("❌ Jogador não encontrado ou nome ambíguo.", Color3.fromRGB(255, 100, 100))
    end
end)

removeButton.MouseButton1Click:Connect(function()
    local name = inputBox.Text:gsub("^%s*(.-)%s*$", "%1")
    if name ~= "" and Whitelist[name] then
        Whitelist[name] = nil
        UpdateWhitelistUI()
        UpdateAllESPColors()
        ShowWarning(string.format("✅ '%s' removido da Whitelist.", name), Color3.fromRGB(0, 255, 0))
        inputBox.Text = ""
    elseif name == "" then
        ShowWarning("❌ Digite um nome para remover.", Color3.fromRGB(255, 100, 100))
    else
        ShowWarning("⚠️ Esse nome não está na Whitelist.", Color3.fromRGB(255, 200, 0))
    end
end)

