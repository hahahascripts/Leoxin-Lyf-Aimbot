-- ============ LOOP DE VERIFICAÇÃO + RENDER ============
local checkTimer = 0

RunService.RenderStepped:Connect(function(dt)
    -- 1. Aimbot (se ativado)
    if Settings.AimbotEnabled then
        UpdateAimbot()
    end

    -- 2. Verificação de estado do ESP (segue sua sugestão mais sólida)
    checkTimer = checkTimer + dt
    if checkTimer >= 0.5 then -- Verifica a cada 0.5 segundos
        checkTimer = 0

        if not Settings.ESPEnabled then
            if next(HighlightObjects) then
                RemoveAllESP()
            end
            return
        end

        -- Itera sobre todos os jogadores para garantir que o ESP esteja funcionando
        for _, player in ipairs(Players:GetPlayers()) do
            if player == LocalPlayer then continue end

            local char = player.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then
                if HighlightObjects[player] then
                    RemovePlayerESP(player)
                end
                continue
            end

            local esp = HighlightObjects[player]

            -- Se não existe ESP, ou se o personagem mudou (respawn) sem avisar
            if not esp or esp.Highlight.Parent ~= char then
                SetupPlayerESP(player)
            else
                -- Se já existe, apenas certificamos que os Enabled estão corretos e a cor atualizada
                esp.Highlight.Enabled = Settings.HighlightRed
                esp.Billboard.Enabled = Settings.ShowNames
                
                local cor = GetESPColor(player)
                esp.Highlight.FillColor = cor
                esp.Highlight.OutlineColor = cor
                esp.Text.TextColor3 = cor
            end
        end
    end

    -- 3. Atualização dos textos (distância) em tempo real (acontece a cada frame)
    if Settings.ESPEnabled then
        UpdateESPTexts()
    end
end)
