local function ToggleMinimize()
    Settings.WindowMinimized = not Settings.WindowMinimized
    ContentContainer.Visible = not Settings.WindowMinimized
    TabContainer.Visible = not Settings.WindowMinimized
    if Settings.WindowMinimized then
        MainFrame.Size = UDim2.new(MainFrame.Size.X.Scale, MainFrame.Size.X.Offset, 0, 50)
    else
        if IsMobile then
            MainFrame.Size = UDim2.new(0.9, 0, 0.8, 0)
        else
            MainFrame.Size = UDim2.new(0, 700, 0, 520)
        end
    end
    MinimizeButton.Text = Settings.WindowMinimized and "□" or "-"
end
MinimizeButton.MouseButton1Click:Connect(ToggleMinimize)

