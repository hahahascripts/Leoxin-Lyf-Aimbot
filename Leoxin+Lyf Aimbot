-- ============ FUNÇÕES AUXILIARES DE COR ============
local function GetESPColor(player)
    if Whitelist[player.Name] then
        return Color3.fromRGB(144, 238, 144) -- Verde claro (Whitelist)
    end
    if Settings.TeamCheck and LocalPlayer.Team and player.Team == LocalPlayer.Team then
        return Color3.new(0, 1, 0) -- Verde (Aliado)
    end
    return Color3.new(1, 0, 0) -- Vermelho (Inimigo)
end

-- ============ FUNÇÕES DO ESP ============
-- Cria os objetos ESP para o jogador
local function SetupPlayerESP(player)
    if player == LocalPlayer then return end
    if not Settings.ESPEnabled then return end

    -- Remove lixo antigo se existir (garantia de limpeza)
    if HighlightObjects[player] then
        pcall(function()
            if HighlightObjects[player].Highlight then HighlightObjects[player].Highlight:Destroy() end
            if HighlightObjects[player].Billboard then HighlightObjects[player].Billboard:Destroy() end
        end)
        HighlightObjects[player] = nil
    end

    local character = player.Character
    if not character then return end
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return end -- O loop de 0.5s vai tentar de novo depois

    -- Criando o Highlight (que será controlado pelo .Enabled)
    local highlight = Instance.new("Highlight")
    local cor = GetESPColor(player)
    highlight.FillColor = cor
    highlight.FillTransparency = 0.3
    highlight.OutlineColor = cor
    highlight.OutlineTransparency = 0.1
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Adornee = character
    highlight.Enabled = Settings.HighlightRed -- Aqui a mágica acontece
    highlight.Parent = character

    -- Criando o Billboard (que será controlado pelo .Enabled)
    local billboard = Instance.new("BillboardGui")
    billboard.Adornee = character
    billboard.Size = UDim2.new(0, 140, 0, 35)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = true
    billboard.Enabled = Settings.ShowNames -- Aqui a mágica acontece
    billboard.Parent = character

    local text = Instance.new("TextLabel")
    text.BackgroundTransparency = 1
    text.TextStrokeTransparency = 0.3
    text.TextScaled = true
    text.Size = UDim2.new(1, 0, 1, 0)
    text.TextColor3 = cor
    text.Font = Enum.Font.GothamBold
    text.TextSize = 10
    text.TextStrokeColor3 = Color3.new(0, 0, 0)
    text.Parent = billboard

    HighlightObjects[player] = {
        Highlight = highlight,
        Billboard = billboard,
        Text = text,
        Player = player
    }
end

-- Atualiza textos e cores (executado a cada frame)
local function UpdateESPTexts()
    if not Settings.ESPEnabled then return end

    for player, esp in pairs(HighlightObjects) do
        if esp.Text and player.Character and player.Character.Parent then
            local distance = 0
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("HumanoidRootPart") then
                distance = (LocalPlayer.Character.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude
            end

            local cor = GetESPColor(player)
            local teamText = ""
            if Settings.TeamCheck and LocalPlayer.Team and player.Team == LocalPlayer.Team then
                teamText = " [ALIADO]"
            end

            esp.Highlight.FillColor = cor
            esp.Highlight.OutlineColor = cor
            esp.Text.Text = string.format("%s%s\n%.1f m", player.Name, teamText, distance)
            esp.Text.TextColor3 = cor
        end
    end
end

-- Atualiza as cores de TODOS instantaneamente (usado quando altera a Whitelist)
local function UpdateAllESPColors()
    for player, esp in pairs(HighlightObjects) do
        if esp.Highlight and esp.Text and player.Character then
            local cor = GetESPColor(player)
            esp.Highlight.FillColor = cor
            esp.Highlight.OutlineColor = cor
            esp.Text.TextColor3 = cor
        end
    end
end

-- Remove ESP de um jogador específico
local function RemovePlayerESP(player)
    if HighlightObjects[player] then
        pcall(function()
            if HighlightObjects[player].Highlight then HighlightObjects[player].Highlight:Destroy() end
            if HighlightObjects[player].Billboard then HighlightObjects[player].Billboard:Destroy() end
        end)
        HighlightObjects[player] = nil
    end
end

-- Remove TODOS os ESPs
local function RemoveAllESP()
    for player, esp in pairs(HighlightObjects) do
        pcall(function()
            if esp.Highlight then esp.Highlight:Destroy() end
            if esp.Billboard then esp.Billboard:Destroy() end
        end)
    end
    table.clear(HighlightObjects)
end

-- ============ AIMBOT (SEM WALLBANG) ============
local function GetTargetPart(player)
    if Settings.AimbotPart == "Head" then
        return player.Character:FindFirstChild("Head")
    elseif Settings.AimbotPart == "Torso" then
        local torso = player.Character:FindFirstChild("UpperTorso") or
                      player.Character:FindFirstChild("Torso") or
                      player.Character:FindFirstChild("HumanoidRootPart")
        return torso
    end
    return nil
end

local function IsVisible(part)
    if not part then return false end
    local origin = Camera.CFrame.Position
    local direction = (part.Position - origin).Unit * (part.Position - origin).Magnitude
    local ray = Ray.new(origin, direction)
    local hit, position = workspace:FindPartOnRay(ray, LocalPlayer.Character)
    if hit then
        if hit:IsDescendantOf(part.Parent) then return true end
        return false
    end
    return true
end

local function GetClosestPlayerToScreenCenter()
    local closestPlayer = nil
    local closestDistance = math.huge
    local screenCenter = Camera.ViewportSize / 2
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local humanoid = player.Character:FindFirstChild("Humanoid")
            if humanoid and humanoid.Health > 0 then
                if Settings.TeamCheck and LocalPlayer.Team and player.Team == LocalPlayer.Team then
                else
                    if Whitelist[player.Name] then continue end
                    local targetPart = GetTargetPart(player)
                    if targetPart then
                        if not IsVisible(targetPart) then continue end
                        local vector, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                        if onScreen then
                            local distanceToCenter = (Vector2.new(vector.X, vector.Y) - screenCenter).Magnitude
                            if distanceToCenter < closestDistance then
                                closestDistance = distanceToCenter
                                closestPlayer = player
                            end
                        end
                    end
                end
            end
        end
    end
    return closestPlayer, closestDistance
end

local function UpdateAimbot()
    if not Settings.AimbotEnabled then 
        CurrentTarget = nil
        return 
    end
    
    local target, distanceToCenter = GetClosestPlayerToScreenCenter()
    local activationRadius = 300
    
    if target and distanceToCenter < activationRadius then
        CurrentTarget = target
        local targetPart = GetTargetPart(target)
        if targetPart and IsVisible(targetPart) then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPart.Position)
        end
    elseif CurrentTarget then
        if CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("Humanoid") and CurrentTarget.Character.Humanoid.Health > 0 and not Whitelist[CurrentTarget.Name] then
            local targetPart = GetTargetPart(CurrentTarget)
            if targetPart and IsVisible(targetPart) then
                local vector, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                if onScreen then
                    local screenCenter = Camera.ViewportSize / 2
                    local distToCenter = (Vector2.new(vector.X, vector.Y) - screenCenter).Magnitude
                    if distToCenter < 400 then
                        Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPart.Position)
                        return
                    end
                end
            end
        end
        CurrentTarget = nil
    end
end

